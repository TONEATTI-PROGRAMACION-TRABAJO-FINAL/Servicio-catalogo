# Copy this file to .env and replace the fictitious values with the ones sent by the cátedra.
# Never commit the real .env.

# Optional: HTTP port of this service. Without it, 8081.
CATALOGO_SERVER_PORT=8081

# Integration with the cátedra.
CATEDRA_API_BASE_URL=https://catedra.example.com
CATEDRA_JWT=jwt-tecnico-ficticio
# Optional: timeouts of the REST client (ISO-8601 duration). Without them, PT2S and PT10S.
# CATEDRA_CONNECT_TIMEOUT=PT2S
# CATEDRA_READ_TIMEOUT=PT10S
# Optional: catalog synchronization at startup and its retries. Without them, true, 8, PT2S and PT60S.
# CATEDRA_SYNC_ON_STARTUP=true
# CATEDRA_SYNC_MAX_ATTEMPTS=8
# CATEDRA_SYNC_INITIAL_BACKOFF=PT2S
# CATEDRA_SYNC_MAX_BACKOFF=PT60S
# Optional: periodic comparison of versions. Without them, true and PT1M.
# CATEDRA_SYNC_POLL_ENABLED=true
# CATEDRA_SYNC_POLL_INTERVAL=PT1M
CATEDRA_REDIS_HOST=redis.catedra.example.com
CATEDRA_REDIS_PORT=6379
CATEDRA_REDIS_USERNAME=grp_mi-proyecto
CATEDRA_REDIS_PASSWORD=password-redis-ficticio
CATEDRA_REDIS_READ_NAMESPACE=catedra:sync:*
# Optional: timeouts of the Redis client (ISO-8601 duration). Without them, PT2S and PT2S.
# CATEDRA_REDIS_CONNECT_TIMEOUT=PT2S
# CATEDRA_REDIS_COMMAND_TIMEOUT=PT2S
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=kafka.catedra.example.com:9092
CATEDRA_KAFKA_CONSUMER_GROUP_ID=alumnos-mi-proyecto
CATEDRA_KAFKA_CATALOG_TOPIC=catedra.catalog.mi-proyecto
